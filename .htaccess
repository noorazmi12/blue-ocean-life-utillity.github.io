# SMART-KJA OWC — konfigurasi Apache
Options -Indexes

# Blokir akses langsung ke file sensitif di root
<FilesMatch "^\.(env|git.*)$">
    Require all denied
</FilesMatch>

# Sembunyikan header versi PHP (jika diizinkan oleh konfigurasi server)
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>

# Kompresi teks (opsional, meningkatkan performa)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
